{
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GOOGLE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "rss": [
      {
        "name": "Hacker News",
        "url": "https://news.ycombinator.com/rss",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/rss",
        "enabled": false,
        "profile": "tech-news"
      },
      {
        "name": "ArXiv Daily Papers",
        "url": "https://huggingface.co/papers/rss",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "Product Hunt",
        "url": "https://www.producthunt.com/feed",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "Hacker News AI",
        "url": "https://hnrss.org/newest?q=AI",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "reddit": [
      {
        "name": "r/LocalLLaMA",
        "subreddit": "LocalLLaMA",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "r/ClaudeCode",
        "subreddit": "ClaudeCode",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "r/MachineLearning",
        "subreddit": "MachineLearning",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "web": [
      {
        "name": "TechCrunch",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "The Verge",
        "url": "https://www.theverge.com/rss/index.xml",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "36Kr",
        "url": "https://36kr.com/feed",
        "enabled": true,
        "profile": "tech-news"
      }
    ]
  },
  "output": {
    "docs_dir": "docs",
    "index_title": "Horizon Daily Briefing",
    "max_items_per_section": 20,
    "max_description_length": 300,
    "date_format": "%Y-%m-%d"
  },
  "webhook": {
    "enabled": false,
    "url_env": "DISCORD_WEBHOOK_URL",
    "username": "Horizon",
    "max_embeds": 10
  }
}
